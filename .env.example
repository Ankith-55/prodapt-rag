# Copy this file to .env and fill in your key:   cp .env.example .env     (Windows: copy .env.example .env)
# .env is gitignored. Never commit a real key. Save it as plain ASCII/UTF-8 with no spaces around "=".

# Required to answer complaints (parsing and drafting). Not needed to run the tests or to build the index.
OPENAI_API_KEY=sk-REPLACE-ME

# --- Optional ---------------------------------------------------------------

# Model used for parsing and drafting (default: gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# If set, /ask, /ingest and /reload require this value in an X-API-Key header, and the UI shows an "Access key" field.
# Leave unset for local use.
# TICKETRAG_API_KEY=choose-a-long-random-string

# Higher rate limits when downloading data with scripts/fetch_data.py (works without it).
# SOCRATA_APP_TOKEN=

# Other settings have defaults and are set by the Dockerfile / Kubernetes ConfigMap:
# TICKETRAG_STATE, TICKETRAG_GATE (similarity threshold, 0.74), TICKETRAG_K (5), TICKETRAG_SIBLINGS (0),
# TICKETRAG_IMMUTABLE (1 disables /ingest), TICKETRAG_CACHE_DIR.
